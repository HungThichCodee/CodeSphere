@using CodeSphere.ViewModels.Blog.ViewModels
@using CodeSphere.ViewModels.Blog.InputModels
@model AiPostPreviewViewModel
@{
    ViewData["Title"] = "Preview AI Generated Post";
}

<div id="banner-area">
    <img src="~/images/banner/banner2.jpg" alt="" />
    <div class="parallax-overlay"></div>
    <div class="banner-title-content">
        <div class="text-center">
            <h2>Preview AI Generated Post</h2>
            <ul class="breadcrumb">
                <li>Home</li>
                <li><a asp-area="" asp-controller="Blog" asp-action="Index"> Blog</a></li>
                <li><a asp-area="" asp-controller="Ai" asp-action="PreviewPost"> Preview</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="container">
    <h1>Preview Your AI Generated Post</h1>
    <hr />
</div>

<div class="container">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            @TempData["Error"]
        </div>
    }

    <div class="row">
        <!-- Preview Content -->
        <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
            <div class="post">
                <div class="post-header">
                    <h2 class="post-title">@Model.GeneratedPost.ExtractedTitle</h2>
                </div>
                <div class="post-body">
                    <div class="ai-generated-content">
                        @Html.Raw(Markdig.Markdown.ToHtml(Model.GeneratedPost.Content))
                    </div>
                </div>
            </div>
        </div>

        <!-- Save Form -->
        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3>Save This Post</h3>
                </div>
                <div class="panel-body">
                    <form method="post" asp-action="SavePost" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="form-group">
                            <label>Title</label>
                            <input name="Title" class="form-control" value="@Model.GeneratedPost.ExtractedTitle" required />
                        </div>

                        <div class="form-group">
                            <label>Category</label>
                            <select name="CategoryName" class="form-control" required>
                                <option value="">Select Category...</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Tags</label>
                            <select multiple="multiple" name="TagsNames" class="form-control multiselect">
                                @foreach (var tag in Model.Tags)
                                {
                                    <option value="@tag">@tag</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Cover Image (Optional)</label>
                            <input type="file" name="CoverImage" class="form-control" />
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-success btn-block">
                                <i class="fas fa-save"></i> Save Post
                            </button>
                            <a asp-action="GeneratePost" class="btn btn-secondary btn-block">
                                <i class="fas fa-redo"></i> Generate Another
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Similar Posts -->
            @if (Model.GeneratedPost.SimilarPosts.Any())
            {
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3>Similar Posts</h3>
                    </div>
                    <div class="panel-body">
                        <ul class="list-group">
                            @foreach (var post in Model.GeneratedPost.SimilarPosts)
                            {
                                <li class="list-group-item">
                                    <a asp-controller="Post" asp-action="Index" asp-route-id="@post.Id">
                                        @post.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/multiSelect.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
