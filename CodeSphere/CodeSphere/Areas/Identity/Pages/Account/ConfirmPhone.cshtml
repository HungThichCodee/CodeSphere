@page
@model ConfirmPhoneModel
@{
    ViewData["Title"] = "Confirm Phone number";
}
<div id="banner-area">
    <img src="~/images/banner/banner2.jpg" alt="" />
    <div class="parallax-overlay"></div>
    <!-- Subpage title start -->
    <div class="banner-title-content">
        <div class="text-center">
            <h2>Confirm Phone Number</h2>
            <ul class="breadcrumb">
                <li>Home</li>
                <li><a asp-area="Identity" asp-page="/Account/ConfirmPhone"> Confirm Phone</a></li>
            </ul>
        </div>
    </div>
</div>
<div class="container">
    <h4>@ViewData["Title"]</h4>
    <div class="row">
        <div class="col-md-6">
            <div asp-validation-summary="All" class="text-danger"></div>
            <p>
                Confirming your phone number @Model.PhoneNumber...
            </p>
            <p>
                Please wait while we process your request.
            </p>
        </div>
    </div>
</div>